{
  "name": "model-gallery",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/api/index.ts",
    "test": "node --test \"src/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"*.json\" \"config.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"*.json\" \"config.json\""
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
